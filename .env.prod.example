# AI Home Hub – Production environment variables
# Copy this file to .env.prod and adjust values.

# Application
APP_PORT=8000
SAFE_MODE=true
TZ=Europe/Prague

# Resource limits
APP_MEMORY_LIMIT=2g
OLLAMA_MEMORY_LIMIT=4g

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=30m

# LLM Backend: "ollama" (default) or "openai_compatible" (for llama-server, LM Studio, etc.)
LLM_BACKEND=ollama

# Per-profile model overrides (optional)
# LLM_MODEL_CHAT=qwen2.5:7b-instruct-q4_K_M
# LLM_CTX_CHAT=4096
# LLM_TEMP_CHAT=0.7
# LLM_TIMEOUT_CHAT=90
# LLM_MODEL_RESIDENT_REASONER=qwen2.5:7b-instruct-q4_K_M
# LLM_CTX_RESIDENT_REASONER=3072
# LLM_TIMEOUT_RESIDENT_REASONER=120

# Resident agent prompt tuning
# MAX_REASONER_PROMPT_TOKENS=700

# Web search rate limit
# WEB_SEARCH_PER_HOUR=10

# Grafana (only used when monitoring profile is active)
# Start with: docker compose -f docker-compose.prod.yml --profile monitoring up -d
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=changeme
