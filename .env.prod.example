# AI Home Hub – Production environment variables
# Copy this file to .env.prod and adjust values.

# Application
APP_PORT=8000
SAFE_MODE=true
TZ=Europe/Prague

# Resource limits
APP_MEMORY_LIMIT=2g
OLLAMA_MEMORY_LIMIT=4g

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# Enable flash attention for faster inference on supported GPUs
OLLAMA_FLASH_ATTENTION=1
# Keep model loaded in memory between requests (reduces cold-start latency)
OLLAMA_KEEP_ALIVE=30m

# Adaptive Keep-Alive thresholds (% system RAM used)
# Below RAM_THRESHOLD_REDUCED  → keep_alive="10m"
# RAM_THRESHOLD_REDUCED–75 %  → keep_alive="2m"
# RAM_THRESHOLD_AGGRESSIVE–85% → keep_alive="30s"
# Above RAM_THRESHOLD_CRITICAL → keep_alive="0" (unload immediately)
RAM_THRESHOLD_REDUCED=60
RAM_THRESHOLD_AGGRESSIVE=75
RAM_THRESHOLD_CRITICAL=85
# Number of GPU layers to offload (0 = CPU only, -1 = all layers)
# OLLAMA_NUM_GPU=0

# LLM Backend: "ollama" (default) or "openai_compatible" (for llama-server, LM Studio, etc.)
LLM_BACKEND=ollama

# Per-profile model overrides (optional – uncomment to customize)
# Primary chat model
# LLM_MODEL_CHAT=qwen2.5:7b-instruct-q4_K_M
# LLM_CTX_CHAT=4096
# LLM_TEMP_CHAT=0.7
# LLM_TIMEOUT_CHAT=90

# Resident agent reasoner model (lower temp = more focused reasoning)
# LLM_MODEL_RESIDENT_REASONER=qwen2.5:7b-instruct-q4_K_M
# LLM_CTX_RESIDENT_REASONER=3072
# LLM_TIMEOUT_RESIDENT_REASONER=120

# Background job model (smaller model for async tasks like reflection, summaries)
# LLM_MODEL_BACKGROUND_JOB=llama3.2:3b-instruct

# Resident agent prompt tuning
# MAX_REASONER_PROMPT_TOKENS=700

# Web search rate limit (max searches per hour for the resident agent)
# WEB_SEARCH_PER_HOUR=10

# Notifications – in-app notification system
# Master switch: disable to suppress all in-app notifications
NOTIFICATIONS_ENABLED=true
# Minimum importance (1-10) for WS broadcast; lower-importance still saved to DB
NOTIFICATION_MIN_IMPORTANCE=6
# Max notifications the resident agent can send per hour
RESIDENT_MAX_NOTIFICATIONS_PER_HOUR=3
# Daily digest: automated 24h summary from the resident agent
RESIDENT_DAILY_DIGEST_ENABLED=true
# Hour (0-23 UTC) when the daily digest is sent
RESIDENT_DAILY_DIGEST_HOUR=18

# Grafana (only used when monitoring profile is active)
# Start with: docker compose -f docker-compose.prod.yml --profile monitoring up -d
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=changeme
